<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hat.Mobile.Views.ProductDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Hat.Mobile.Converters"
    xmlns:vm="clr-namespace:Hat.Mobile.ViewModels"
    Title="Product Detail">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <Style x:Key="LBL" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
        
        <!--Loading-->
        <ActivityIndicator
            HeightRequest="45"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoaded, Converter={StaticResource InverseBoolConverter}}"
            VerticalOptions="Center"
            WidthRequest="45"
            Color="{StaticResource Primary}" />

     
        
        <!--Details-->
        <Grid IsVisible="{Binding IsLoaded}">
            <ScrollView>
                <Grid IsClippedToBounds="True" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                         <Image
                        Grid.Row="0"
                        Aspect="AspectFill"
                        HeightRequest="200"
                        Source="{Binding Product.ImageUrl}" />
                        <!--Picture-->
                        <Grid
       Margin="15"
       HeightRequest="42"
       ColumnDefinitions="Auto,*,Auto"
       VerticalOptions="Start"
       RowSpacing="0"
       Grid.Row="0"
       Grid.ColumnSpan="2"
       ZIndex="1">
                            <Border
           Grid.Column="0"
           Padding="0"
           Background="transparent"
           HeightRequest="40"
           StrokeShape="RoundRectangle 20,20,20,20"
           StrokeThickness="0"
           WidthRequest="40">
                                <Label
               FontFamily="MaterialIcon"
               FontSize="26"
               HorizontalOptions="Center"
               TextColor="Black"
               VerticalOptions="Center">
                                    <Label.Text>
                                        <OnPlatform x:TypeArguments="x:String">
                                            <On Platform="Android" Value="&#xf04d;" />
                                            <On Platform="iOS" Value="&#xf141;" />
                                            <On Platform="Default" Value="&#xf04d;" />
                                        </OnPlatform>
                                    </Label.Text>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border
           Grid.Column="2"
           Padding="0"
           Background="white"
           HeightRequest="40"
           StrokeShape="RoundRectangle 20,20,20,20"
           StrokeThickness="1"
           WidthRequest="40">
                                <Label
               FontFamily="MaterialIcon"
               FontSize="26"
               HorizontalOptions="Center"
               Text="&#xf4d2;"
               TextColor="{Binding FavStatusColor}"
               VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FavCommand}" CommandParameter="{Binding FavStatusColor}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Grid>
                  
                    <Grid Grid.Row="1" Margin="16" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label
                            Grid.Row="0"
                            FontAttributes="Bold"
                            FontSize="26"
                            Text="{Binding Product.Name}"
                            TextColor="Black"
                            VerticalTextAlignment="Center" />

                        <!--Available or not-->
                        <Label
                            Grid.Row="1"
                            FontAttributes="Bold"
                            FontSize="10" Padding="3" Margin="0,0,15,0"
                            Text="{Binding Product.AvailableText}"
                            TextColor="White" 
                            BackgroundColor="{Binding Product.AvailableColor}"
                            VerticalTextAlignment="Center" />

                        <!--Size-->
                        <Label Grid.Row="2" Style="{StaticResource LBL}">Options</Label>
                        <ScrollView Grid.Row="3" HorizontalOptions="Center">
                            <CollectionView 
                                ItemsSource="{Binding Product.ProductSizes}"
                                ItemsLayout="HorizontalList"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedSize}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding}" Margin="0,10,0,10" HorizontalOptions="Center"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>

                        <!--Color-->
                        <Label Grid.Row="4" Style="{StaticResource LBL}">Color</Label>
                        <ScrollView Grid.Row="5">
                            <CollectionView  ItemsSource="{Binding Product.ProductColors}"
                                ItemsLayout="HorizontalList"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedColor}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <VerticalStackLayout>
                                                <Border
                                                    BackgroundColor="{Binding}" 
                                                    HeightRequest="26"
                                                    HorizontalOptions="Start"
                                                    StrokeShape="RoundRectangle 8"
                                                    StrokeThickness="1"
                                                    WidthRequest="26" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>

                        <!--Details-->
                        <Label Grid.Row="6" Style="{StaticResource LBL}">Details</Label>
                        <Label
                            Grid.Row="7"
                            FontSize="14"
                            Text="{Binding Product.Details}"
                            TextColor="Black"
                            VerticalTextAlignment="Center" />

                        <!--Vat-->
                        <Label Grid.Row="8" Style="{StaticResource LBL}">VAT</Label>
                        <Label
                            Grid.Row="9"
                            FontSize="14"
                            Text="{Binding Product.VatRate}"
                            TextColor="Black"
                            VerticalTextAlignment="Center" />

                        <!--Options Grid-->
                        <Label Grid.Row="10" Style="{StaticResource LBL}">Options</Label>
                        <Border Grid.Row="11"  Stroke="{StaticResource Primary}"
  StrokeThickness="1"
  Margin="1,1,1,1"
  Padding="4"
  StrokeShape="RoundRectangle 0,0,0,0">
                            <CollectionView  ItemsSource="{Binding Product.Options}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Stroke="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        Margin="1,1,1,1"
                                        Padding="4"
                                        StrokeShape="RoundRectangle 0,0,0,0">
                                        <Grid ColumnDefinitions="*,2*">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   VerticalOptions="Center"
                                                   FontSize="16"/>
                                            <!-- ValueType-dependent input -->
                                            <ContentView Grid.Column="1" VerticalOptions="Center">
                                                <ContentView.Style>
                                                    <Style TargetType="ContentView">
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="ContentView"
                                                                         Binding="{Binding ValueType}"
                                                                         Value="Text">
                                                                <Setter Property="ContentView.Content">
                                                                    <Setter.Value>
                                                                        <Entry
                                                                            Text="{Binding Value, Mode=TwoWay}"
                                                                            FontSize="16"
                                                                            Placeholder="Enter value"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="ContentView"
                                                                         Binding="{Binding ValueType}"
                                                                         Value="Number">
                                                                <Setter Property="ContentView.Content">
                                                                    <Setter.Value>
                                                                        <Entry
                                                                            Text="{Binding Value, Mode=TwoWay, StringFormat='{}{0:N0}'}"
                                                                            Keyboard="Numeric"
                                                                            FontSize="16"
                                                                            Placeholder="Enter number"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="ContentView"
                                                                         Binding="{Binding ValueType}"
                                                                         Value="Selection">
                                                                <Setter Property="ContentView.Content">
                                                                    <Setter.Value>
                                                                        <Picker ItemsSource="{Binding Selections}"
                                                                                SelectedItem="{Binding SelectedSelection, Mode=TwoWay}"
                                                                                Title="Select option"
                                                                                ItemDisplayBinding="{Binding Value}"
                                                                                HorizontalOptions="Start"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentView.Style>
                                            </ContentView>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        </Border>
                        <!--Reviews-->
                        <Label Grid.Row="12" Style="{StaticResource LBL}">Reviews</Label>
                        <Label
                            Grid.Row="13"
                            Margin="0,5,0,0"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Write your Review"
                            TextColor="{StaticResource Primary}"
                            VerticalTextAlignment="Center" />
                        <CollectionView
                            Grid.Row="14"
                            Margin="0,16"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemsSource="{Binding Product.Reviews}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border
                                            Grid.Column="0"
                                            Padding="0"
                                            HeightRequest="46"
                                            StrokeShape="RoundRectangle 23"
                                            StrokeThickness="0"
                                            WidthRequest="46">
                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="46"
                                                Source="{Binding ImageUrl}"
                                                WidthRequest="46" />
                                        </Border>
                                        <Grid
                                            Grid.Column="1"
                                            Margin="8,0"
                                            RowDefinitions="Auto,2,Auto">
                                            <Label
                                                Grid.Row="0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding Name}"
                                                TextColor="Black" />
                                            <Label
                                                Grid.Row="2"
                                                FontSize="14"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Review}"
                                                TextColor="Black"
                                                VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>
            </ScrollView>

           
        </Grid>


        <!--Action Bar-->
        <Grid
            Grid.Row="1"
            Margin="0,8,8,16"
            ColumnDefinitions="32,Auto,*,Auto,16"
            IsVisible="{Binding IsLoaded}">
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                <Label
                    Grid.Row="0"
                    FontSize="12"
                    Text="PRICE"
                    TextColor="{StaticResource SecondaryTextColor}" />
                <Label
                    Grid.Row="1"
                    FontSize="18"
                    Text="{Binding Product.Price, StringFormat='${0:F2}'}"
                    TextColor="{StaticResource Primary}" />
            </Grid>

            <Button
                IsEnabled="{Binding CanAddToCart}"
                Grid.Column="3"
                Padding="16"
                Background="{DynamicResource Primary}"
                Command="{Binding AddToCartCommand}"
                CornerRadius="4"
                Text="ADD TO CART"
                TextColor="{DynamicResource White}" />
        </Grid>
    </Grid>
</ContentPage>