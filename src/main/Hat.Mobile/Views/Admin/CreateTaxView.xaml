<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hat.Mobile.Views.CreateTaxView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Hat.Mobile.Converters"
    Title="Create Vat">



    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Vat Name" />
            <Entry Text="{Binding VatName}" Placeholder="Enter Vat name" />

            <Label Text="Code" />
            <Entry Text="{Binding Code}" Placeholder="Enter brand name" />

            <Label Text="Rate" />
            <Entry Text="{Binding Rate}" Placeholder="Enter price" Keyboard="Numeric" />

          
            <Button
                Text="Create Vat"
                Command="{Binding CreateVatCommand}"
                BackgroundColor="{DynamicResource Primary}"
                TextColor="White"
                CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>